{% if errors|length > 0 %}
	<div class="error" style="padding: 6px 8px; margin-bottom: 10px;">
		{% for error in errors %}
			{{ error }}<br/>
		{% endfor %}
	</div>
{% endif %}

{% if builds|length > 0 %}
	<table border="0" cellspacing="1" cellpadding="4" width="100%">
		<tr bgcolor="{{ config.vdarkborder }}">
			<td width="30%"><span class="white"><b>Client</b></span></td>
			<td width="15%"><span class="white"><b>Platform</b></span></td>
			<td width="15%"><span class="white"><b>Size</b></span></td>
			<td width="15%"><span class="white"><b>Date</b></span></td>
			<td><span class="white"><b>Download</b></span></td>
		</tr>
		{% set i = 0 %}
		{% for build in builds %}
		<tr bgcolor="{{ getStyle(i) }}">
			<td>{{ build.name }}</td>
			<td>{{ build.platform|default('-') }}</td>
			<td>{{ build.size }}</td>
			<td>{{ build.date }}</td>
			<td><a href="{{ build.url }}">download</a>{% if build.note is defined and build.note %} &mdash; {{ build.note }}{% endif %}</td>
		</tr>
		{% set i = i + 1 %}
		{% endfor %}
	</table>
{% else %}
	<p>No client package has been published for download yet.</p>
{% endif %}

{% if webclient_url %}
	<h3>Play in your browser</h3>
	<p>
		Nothing to install - the same game runs in your browser:
		<a href="{{ webclient_url }}">{{ webclient_url }}</a>
	</p>
{% endif %}

<h3>Getting started</h3>
<ul>
	<li>Download the package for your system and unpack it into a folder of your own.</li>
	<li>Start the client and log in with your account - the server address is already configured in the package.</li>
	<li>The client is our own AstraClient build: only this one supports every server feature (rare monster icons, market, forge window, wheel).</li>
</ul>
