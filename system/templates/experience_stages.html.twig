{% macro stages_table(title, list) %}
<div style="text-align:center">
	<h3>{{ title }}</h3>
</div>
<table style="border: 0; background-color: {{ config.darkborder }}; width: 100%" cellpadding="4" cellspacing="1">
	<tbody>
		<tr>
			<td>
				<table style="border: 0; width: 100%" cellpadding="2" cellspacing="1"><tbody>
					<tr style="background-color: {{ config.lightborder }}">
						<td><b>Level</b></td>
						<td><b>Stage</b></td>
					</tr>
					{% for stage in list %}
						<tr style="background-color: {{ config.lightborder }}">
							<td>{{ stage.levels }}</td><td>x{{ stage.multiplier }}</td>
						</tr>
					{% endfor %}
				</tbody>
				</table>
			</td>
		</tr>
	</tbody>
</table>
<br/>
{% endmacro %}
{% if sections is defined and sections|length > 0 %}
	{% for section in sections %}
		{{ _self.stages_table(section.title, section.stages) }}
	{% endfor %}
{% else %}
	{{ _self.stages_table("Experience stages", stages) }}
{% endif %}
